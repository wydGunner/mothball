  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "build:ui": "node ui/build.mjs",
    "watch:ui": "node ui/build.mjs --watch",
    "typecheck": "tsc -p ui --noEmit",
    "test:core": "cargo test --manifest-path crates/vault-core/Cargo.toml",
    "test:ui": "node scripts/ui-smoke.mjs",
    "devserver": "cargo run --manifest-path crates/vault-core/Cargo.toml --bin vault-devserver -- .devdata ui/dist 1420",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "marked": "^18.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "@tauri-apps/plugin-updater": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "typescript": "^5.8.0"
  }
}